# Fernet key that encrypts Garmin session tokens in the database.
# Generate: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_KEY=
FIREBASE_PROJECT_ID=demo-my-garmin
# Local only: verify Firebase tokens against the Auth emulator.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
CORS_ORIGINS=http://localhost:5180
